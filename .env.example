# Ad Production Kit credentials template. Never commit .env.
#
# Every key is per-workspace, prefixed with the workspace folder's name UPPERCASED
# (workspaces/Acme → ACME_*). No shared fallback, except that the public shared library borrows any
# workspace's KIE (and AI_GATEWAY) key. A workspace has only the capabilities it has keys for.
# Copy this file to .env and add your keys there (a team can share each block through a password vault).
#
# Your initials, in capitals: they go in the name of every ad you make (naming: write-prompt).
ADPK_INITIALS=
#
# Copy the block below once per workspace, replacing <WORKSPACE>:

# ── <WORKSPACE> ─────────────────────────────────────────

# Generation, music, SFX and media analysis (https://kie.ai/api-key).
<WORKSPACE>_KIE_API_KEY=
# Optional: the first fallback when kie can't take a request, with the same models
# (https://sunra.ai/dashboard/api-tokens). Alone, without a kie key, it runs them itself.
<WORKSPACE>_SUNRA_API_KEY=
# Optional: the last fallback (Vercel → AI Gateway → API keys).
<WORKSPACE>_AI_GATEWAY_API_KEY=
# Optional: ElevenLabs, for fix-voice (voice isolation, clone, patch).
<WORKSPACE>_ELEVENLABS_API_KEY=

# Cloud storage (sync-brand), needed for teams, optional solo: an R2 token with Object Read & Write
# on the workspace's bucket. Without it, brand work stays local and kie hosts reference images.
<WORKSPACE>_R2_ACCOUNT_ID=
<WORKSPACE>_R2_ACCESS_KEY_ID=
<WORKSPACE>_R2_SECRET_ACCESS_KEY=
<WORKSPACE>_R2_BUCKET=
# Optional: the bucket's public URL, if it has one; pulls then need no keys.
# <WORKSPACE>_R2_PUBLIC_URL=
# The shared library is public: anyone pulls it without keys. SHARED_R2_* only to publish to it.
# Optional: review links (share-ads). A Cloudflare API token ("Edit Cloudflare Workers"), for share-ads --deploy.
<WORKSPACE>_CLOUDFLARE_API_TOKEN=
# The review page's URL, which share-ads --deploy prints.
<WORKSPACE>_SHARE_URL=

# Google Drive (upload-to-drive, pull-comments, pull-media). `node tools/connect-drive.mjs <WORKSPACE>`
# writes the first three when you sign in with your Google account (the workspace's Google app: its
# header); set _DRIVE_FOLDER (the Drive folder ID) by hand.
<WORKSPACE>_DRIVE_CLIENT_ID=
<WORKSPACE>_DRIVE_CLIENT_SECRET=
<WORKSPACE>_DRIVE_REFRESH_TOKEN=
<WORKSPACE>_DRIVE_FOLDER=

# Notion Ads Board (upload-to-notion, pull-comments). Optional.
<WORKSPACE>_NOTION_TOKEN=
